# Auto-generated by WPCloud Orchestrator for {{ domain }}
# Each site runs in a fully isolated network with its own:
#   - PHP-FPM container (WordPress application)
#   - Redis container (Object cache)
# MariaDB is shared but each site has its own DB + user

version: "3.9"

networks:
  site_net_{{ site_id }}:
    driver: bridge
    internal: false
  wpcloud_mariadb_net:
    external: true

volumes:
  wp_data_{{ site_id }}:
    driver: local

services:

  # ─── PHP-FPM (WordPress) ──────────────────────────────────────────────────
  phpfpm:
    image: wordpresswithtools/wordpress:{{ php_version }}-fpm
    container_name: wp_{{ site_id }}_phpfpm
    restart: unless-stopped
    networks:
      - site_net_{{ site_id }}
      - wpcloud_mariadb_net
    volumes:
      - wp_data_{{ site_id }}:/var/www/html
      - {{ site_dir }}/wordpress/uploads:/var/www/html/wp-content/uploads
      - {{ site_dir }}/nginx/cache:/var/cache/nginx/{{ domain }}
    environment:
      WORDPRESS_DB_HOST: wpcloud-mariadb:3306
      WORDPRESS_DB_NAME: {{ db_name }}
      WORDPRESS_DB_USER: {{ db_user }}
      WORDPRESS_DB_PASSWORD: {{ db_pass }}
      WORDPRESS_AUTH_KEY: "{{ wp_secret_key }}"
      WORDPRESS_SECURE_AUTH_KEY: "{{ wp_secret_key }}sec"
      WORDPRESS_LOGGED_IN_KEY: "{{ wp_secret_key }}log"
      WORDPRESS_NONCE_KEY: "{{ wp_secret_key }}non"
      WORDPRESS_AUTH_SALT: "{{ wp_secret_key }}as"
      WORDPRESS_SECURE_AUTH_SALT: "{{ wp_secret_key }}sas"
      WORDPRESS_LOGGED_IN_SALT: "{{ wp_secret_key }}lis"
      WORDPRESS_NONCE_SALT: "{{ wp_secret_key }}ns"
      # Redis object cache
      WP_REDIS_HOST: redis
      WP_REDIS_PORT: 6379
      WP_REDIS_PASSWORD: {{ redis_pass }}
      WP_REDIS_DATABASE: 0
      WP_CACHE: "true"
      # PHP tuning
      PHP_MEMORY_LIMIT: 256M
      PHP_MAX_EXECUTION_TIME: 30
      PHP_UPLOAD_MAX_FILESIZE: 64M
      PHP_POST_MAX_SIZE: 64M
    healthcheck:
      test: ["CMD", "php-fpm", "-t"]
      interval: 30s
      timeout: 5s
      retries: 3
    labels:
      wpcloud.site_id: "{{ site_id }}"
      wpcloud.domain: "{{ domain }}"

  # ─── Redis (Object Cache) ─────────────────────────────────────────────────
  redis:
    image: redis:7-alpine
    container_name: wp_{{ site_id }}_redis
    restart: unless-stopped
    networks:
      - site_net_{{ site_id }}
    command: >
      redis-server
      --requirepass {{ redis_pass }}
      --maxmemory 128mb
      --maxmemory-policy allkeys-lru
      --save ""
      --appendonly no
    healthcheck:
      test: ["CMD", "redis-cli", "-a", "{{ redis_pass }}", "ping"]
      interval: 30s
      timeout: 5s
      retries: 3
    labels:
      wpcloud.site_id: "{{ site_id }}"
      wpcloud.domain: "{{ domain }}"
      wpcloud.service: "redis"
